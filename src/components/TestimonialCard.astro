---
/**
 * Karta reference podle sekce 6.7 a 8 zadání.
 * Zobrazí se pouze tehdy, když je reference schválena ke zveřejnění (published !== false).
 */
interface Props {
  quote: string;
  author: string;
  company?: string;
  projectLabel?: string;
  projectHref?: string;
  published?: boolean;
}

const {
  quote,
  author,
  company,
  projectLabel,
  projectHref,
  published = true,
} = Astro.props;
---

{
  published && (
    <figure class="testimonial-card" data-reveal>
      <blockquote class="testimonial-card__quote">„{quote}“</blockquote>
      <figcaption class="testimonial-card__meta">
        <span class="testimonial-card__author">{author}</span>
        {company && <span class="testimonial-card__company">{company}</span>}
        {projectLabel && projectHref && (
          <a class="testimonial-card__project" href={projectHref}>
            {projectLabel} &rarr;
          </a>
        )}
      </figcaption>
    </figure>
  )
}

<style>
  .testimonial-card {
    margin: 0;
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .testimonial-card__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-medium);
    line-height: var(--leading-snug);
    color: var(--color-text);
  }

  .testimonial-card__meta {
    padding-top: var(--space-4);
    border-top: var(--border-thin) solid var(--color-border);
    display: grid;
    gap: var(--space-1);
  }

  .testimonial-card__author {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
  }

  .testimonial-card__company {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .testimonial-card__project {
    margin-top: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-accent-ink);
    text-decoration: none;
  }

  .testimonial-card__project:hover {
    text-decoration: underline;
  }
</style>
