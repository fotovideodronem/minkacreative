---
import { siteConfig } from '../config/site';

const currentPath = Astro.url.pathname;

const isServicesActive =
  currentPath.startsWith('/sluzby/') ||
  siteConfig.navigation.servicesGroups.some((group) =>
    group.items.some((item) => item.href === currentPath)
  );
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">
      <span class="site-header__brand-mark" aria-hidden="true"></span>
      <span>{siteConfig.brandName}</span>
    </a>

    <!-- Desktopová navigace -->
    <nav class="desktop-nav" aria-label="Hlavní navigace">
      <div class="nav-dropdown" data-dropdown>
        <button
          type="button"
          class:list={['nav-link', 'nav-dropdown__trigger', { 'is-active': isServicesActive }]}
          aria-expanded="false"
          aria-controls="desktop-services-menu"
          data-dropdown-trigger
        >
          <span>Služby</span>
          <svg
            class="nav-dropdown__chevron"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 6L8 10L12 6"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div id="desktop-services-menu" class="nav-dropdown__panel" data-dropdown-panel hidden>
          <a
            class:list={[
              'nav-dropdown__overview',
              { 'is-active': currentPath === siteConfig.navigation.servicesOverview.href },
            ]}
            href={siteConfig.navigation.servicesOverview.href}
          >
            <span>{siteConfig.navigation.servicesOverview.label}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>

          <div class="nav-dropdown__groups">
            {
              siteConfig.navigation.servicesGroups.map((group) => (
                <div class="nav-dropdown__group">
                  <p class="nav-dropdown__group-title">{group.title}</p>
                  <ul class="nav-dropdown__list">
                    {group.items.map((item) => (
                      <li>
                        <a
                          class:list={[
                            'nav-dropdown__item',
                            { 'is-active': currentPath === item.href },
                          ]}
                          href={item.href}
                        >
                          {item.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      {
        siteConfig.navigation.mainLinks.map((link) => (
          <a
            class:list={['nav-link', { 'is-active': currentPath === link.href }]}
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }

      <a
        class="nav-link nav-link--external"
        href={siteConfig.externalLinks.weddings.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>{siteConfig.externalLinks.weddings.label}</span>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M5 11L11 5M11 5H6.5M11 5V9.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>

      <a class="header-cta" href={siteConfig.navigation.cta.href}>
        {siteConfig.navigation.cta.label}
      </a>
    </nav>

    <!-- Tlačítko mobilního menu -->
    <button
      type="button"
      class="mobile-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav-drawer"
      aria-label="Otevřít menu"
      data-mobile-toggle
    >
      <span class="mobile-toggle__line"></span>
      <span class="mobile-toggle__line"></span>
      <span class="mobile-toggle__line"></span>
    </button>
  </div>

  <!-- Mobilní menu (široké dotykové plochy + rozbalovací seznam Služby) -->
  <div id="mobile-nav-drawer" class="mobile-drawer" data-mobile-drawer hidden>
    <nav class="container mobile-drawer__nav" aria-label="Mobilní navigace">
      <details class="mobile-accordion" open={isServicesActive}>
        <summary class="mobile-accordion__summary">
          <span>Služby</span>
          <svg
            class="mobile-accordion__chevron"
            width="18"
            height="18"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4 6L8 10L12 6"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </summary>

        <div class="mobile-accordion__content">
          <a
            class:list={[
              'mobile-sublink',
              'mobile-sublink--overview',
              { 'is-active': currentPath === siteConfig.navigation.servicesOverview.href },
            ]}
            href={siteConfig.navigation.servicesOverview.href}
          >
            {siteConfig.navigation.servicesOverview.label}
          </a>

          {
            siteConfig.navigation.servicesGroups.map((group) => (
              <div class="mobile-accordion__group">
                <p class="mobile-accordion__group-title">{group.title}</p>
                <ul class="mobile-accordion__list">
                  {group.items.map((item) => (
                    <li>
                      <a
                        class:list={['mobile-sublink', { 'is-active': currentPath === item.href }]}
                        href={item.href}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </details>

      {
        siteConfig.navigation.mainLinks.map((link) => (
          <a
            class:list={['mobile-link', { 'is-active': currentPath === link.href }]}
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }

      <a
        class="mobile-link mobile-link--external"
        href={siteConfig.externalLinks.weddings.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>{siteConfig.externalLinks.weddings.label}</span>
        <span class="mobile-link__domain">minka-weddings.cz &nearr;</span>
      </a>

      <a class="mobile-cta" href={siteConfig.navigation.cta.href}>
        {siteConfig.navigation.cta.label}
      </a>
    </nav>
  </div>
</header>

<script>
  function initHeaderNavigation() {
    const dropdownTrigger = document.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const dropdownPanel = document.querySelector<HTMLElement>('[data-dropdown-panel]');
    const mobileToggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
    const mobileDrawer = document.querySelector<HTMLElement>('[data-mobile-drawer]');

    const setDropdownOpen = (open: boolean) => {
      if (!dropdownTrigger || !dropdownPanel) return;
      dropdownTrigger.setAttribute('aria-expanded', String(open));
      dropdownPanel.hidden = !open;
    };

    const setMobileOpen = (open: boolean) => {
      if (!mobileToggle || !mobileDrawer) return;
      mobileToggle.setAttribute('aria-expanded', String(open));
      mobileToggle.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
      mobileDrawer.hidden = !open;
    };

    if (dropdownTrigger && dropdownPanel && !dropdownTrigger.dataset.bound) {
      dropdownTrigger.dataset.bound = 'true';
      dropdownTrigger.addEventListener('click', (event) => {
        event.stopPropagation();
        const isOpen = dropdownTrigger.getAttribute('aria-expanded') === 'true';
        setDropdownOpen(!isOpen);
      });
    }

    if (mobileToggle && mobileDrawer && !mobileToggle.dataset.bound) {
      mobileToggle.dataset.bound = 'true';
      mobileToggle.addEventListener('click', () => {
        const isOpen = mobileToggle.getAttribute('aria-expanded') === 'true';
        setMobileOpen(!isOpen);
      });

      mobileDrawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMobileOpen(false));
      });
    }

    if (!document.documentElement.dataset.headerGlobalBound) {
      document.documentElement.dataset.headerGlobalBound = 'true';

      document.addEventListener('click', (event) => {
        const currentDropdown = document.querySelector<HTMLElement>('[data-dropdown]');
        if (currentDropdown && !currentDropdown.contains(event.target as Node)) {
          const trigger = currentDropdown.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
          const panel = currentDropdown.querySelector<HTMLElement>('[data-dropdown-panel]');
          if (trigger && panel) {
            trigger.setAttribute('aria-expanded', 'false');
            panel.hidden = true;
          }
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          const trigger = document.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
          const panel = document.querySelector<HTMLElement>('[data-dropdown-panel]');
          const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
          const drawer = document.querySelector<HTMLElement>('[data-mobile-drawer]');

          if (trigger && panel && trigger.getAttribute('aria-expanded') === 'true') {
            trigger.setAttribute('aria-expanded', 'false');
            panel.hidden = true;
            trigger.focus();
          }

          if (toggle && drawer && toggle.getAttribute('aria-expanded') === 'true') {
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', 'Otevřít menu');
            drawer.hidden = true;
            toggle.focus();
          }
        }
      });
    }
  }

  initHeaderNavigation();
  document.addEventListener('astro:page-load', initHeaderNavigation);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background-color: var(--color-header-bg);
    backdrop-filter: blur(var(--space-3));
    border-bottom: var(--border-thin) solid var(--color-border);
  }

  .site-header__inner {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
    white-space: nowrap;
    min-height: var(--touch-target-min);
  }

  .site-header__brand-mark {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Desktopová navigace */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 64rem) {
    .desktop-nav {
      display: flex;
    }
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch-target-min);
    padding-inline: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-muted);
    background: transparent;
    border: none;
    border-radius: var(--radius-md);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-text);
    background-color: var(--color-surface);
  }

  .nav-link.is-active {
    color: var(--color-accent);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown__chevron {
    transition: transform var(--transition-fast);
  }

  .nav-dropdown__trigger[aria-expanded='true'] .nav-dropdown__chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown__panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: var(--z-dropdown);
    width: max-content;
    min-width: calc(var(--space-24) * 3.5);
    padding: var(--space-5);
    background-color: var(--color-surface);
    border: var(--border-thin) solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .nav-dropdown__panel[hidden] {
    display: none;
  }

  .nav-dropdown__overview {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    background-color: var(--color-surface-elevated);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .nav-dropdown__overview:hover,
  .nav-dropdown__overview.is-active {
    color: var(--color-accent);
    background-color: var(--color-accent-soft);
  }

  .nav-dropdown__groups {
    display: grid;
    grid-template-columns: auto auto;
    gap: var(--space-6);
  }

  .nav-dropdown__group-title {
    margin-bottom: var(--space-2);
    padding-inline: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .nav-dropdown__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }

  .nav-dropdown__item {
    display: block;
    padding: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text);
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .nav-dropdown__item:hover,
  .nav-dropdown__item.is-active {
    color: var(--color-accent);
    background-color: var(--color-accent-soft);
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target-min);
    margin-left: var(--space-2);
    padding: var(--space-2) var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-accent-text);
    background-color: var(--color-accent);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--transition-fast);
  }

  .header-cta:hover {
    background-color: var(--color-accent-hover);
  }

  /* Mobilní přepínač */
  .mobile-toggle {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    width: var(--touch-target-min);
    height: var(--touch-target-min);
    padding: 0;
    background-color: var(--color-surface);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  @media (min-width: 64rem) {
    .mobile-toggle {
      display: none;
    }
  }

  .mobile-toggle__line {
    width: var(--space-5);
    height: var(--border-focus);
    background-color: var(--color-text);
    border-radius: var(--radius-pill);
  }

  /* Mobilní šuplík */
  .mobile-drawer {
    background-color: var(--color-surface);
    border-top: var(--border-thin) solid var(--color-border);
    border-bottom: var(--border-thin) solid var(--color-border);
    max-height: calc(100dvh - var(--header-height) - var(--mobile-bar-height));
    overflow-y: auto;
  }

  .mobile-drawer[hidden] {
    display: none;
  }

  @media (min-width: 64rem) {
    .mobile-drawer {
      display: none;
    }
  }

  .mobile-drawer__nav {
    padding-block: var(--space-4) var(--space-6);
    display: grid;
    gap: var(--space-2);
  }

  .mobile-link,
  .mobile-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--space-12);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-text);
    background-color: var(--color-surface-elevated);
    border-radius: var(--radius-md);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .mobile-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .mobile-accordion__chevron {
    transition: transform var(--transition-fast);
  }

  .mobile-accordion[open] .mobile-accordion__chevron {
    transform: rotate(180deg);
  }

  .mobile-accordion__content {
    margin-top: var(--space-2);
    padding: var(--space-3);
    background-color: var(--color-bg);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    display: grid;
    gap: var(--space-4);
  }

  .mobile-accordion__group-title {
    margin-bottom: var(--space-2);
    padding-inline: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .mobile-accordion__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }

  .mobile-sublink {
    display: flex;
    align-items: center;
    min-height: var(--touch-target-min);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    color: var(--color-text);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .mobile-sublink--overview {
    font-weight: var(--font-semibold);
    background-color: var(--color-surface-elevated);
  }

  .mobile-sublink.is-active,
  .mobile-link.is-active {
    color: var(--color-accent);
  }

  .mobile-link__domain {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-regular);
    color: var(--color-text-muted);
  }

  .mobile-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--space-12);
    margin-top: var(--space-2);
    padding: var(--space-3) var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    color: var(--color-accent-text);
    background-color: var(--color-accent);
    border-radius: var(--radius-pill);
    text-decoration: none;
  }
</style>
