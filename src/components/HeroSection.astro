---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';

/**
 * Hlavní Hero sekce přes celou šířku (sekce 6.1 zadání).
 * Poster přes astro:assets vykreslí okamžitý LCP snímek; volitelná video smyčka
 * se připojí až po načtení stránky a jen při vhodném připojení na mobilu.
 */
interface CtaLink {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  lead: string;
  poster: ImageMetadata;
  posterAlt: string;
  videoSrc?: string;
  primaryCta: CtaLink;
  secondaryCta?: CtaLink;
}

const {
  eyebrow,
  heading,
  lead,
  poster,
  posterAlt,
  videoSrc,
  primaryCta,
  secondaryCta,
} = Astro.props;
---

<section class="hero" aria-label={heading}>
  <div class="hero__media" aria-hidden="true">
    <Picture
      src={poster}
      alt={posterAlt}
      formats={['avif', 'webp']}
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      class="hero__poster"
    />

    {
      videoSrc && (
        <video
          class="hero__video"
          data-hero-video
          data-video-src={videoSrc}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        />
      )
    }

    <div class="hero__scrim"></div>
  </div>

  <div class="container hero__content">
    <div class="hero__inner">
      {eyebrow && <span class="hero__eyebrow">{eyebrow}</span>}
      <h1 class="hero__title">{heading}</h1>
      <p class="hero__lead">{lead}</p>
      <div class="hero__actions">
        <Button href={primaryCta.href} variant="primary" size="lg">
          {primaryCta.label}
        </Button>
        {
          secondaryCta && (
            <Button href={secondaryCta.href} variant="media-secondary" size="lg">
              {secondaryCta.label}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  interface NetworkInformationLike {
    saveData?: boolean;
    effectiveType?: string;
  }

  function initHeroVideo() {
    const videos = document.querySelectorAll<HTMLVideoElement>('[data-hero-video]');
    if (videos.length === 0) return;

    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    const nav = navigator as Navigator & { connection?: NetworkInformationLike };
    const connection = nav.connection;
    const isSlowConnection =
      Boolean(connection?.saveData) ||
      connection?.effectiveType === 'slow-2g' ||
      connection?.effectiveType === '2g';

    if (prefersReducedMotion || isSlowConnection) return;

    videos.forEach((video) => {
      const src = video.dataset.videoSrc;
      if (!src || video.dataset.loaded === 'true') return;

      video.dataset.loaded = 'true';
      video.src = src;

      const showVideo = () => {
        video.classList.add('is-ready');
      };

      video.addEventListener('canplay', showVideo, { once: true });
      video.play().catch(() => {
        /* Pokud prohlížeč autoplay zablokuje, zůstane viditelný poster. */
      });
    });
  }

  if (document.readyState === 'complete') {
    initHeroVideo();
  } else {
    window.addEventListener('load', initHeroVideo, { once: true });
  }
  document.addEventListener('astro:page-load', initHeroVideo);
</script>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(30rem, 84svh, 52rem);
    overflow: hidden;
    background-color: var(--color-bg);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__video {
    opacity: 0;
    transition: opacity var(--transition-slow);
  }

  .hero__video.is-ready {
    opacity: 1;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--color-scrim-strong) 0%,
      var(--color-scrim-mid) 48%,
      var(--color-scrim-soft) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: var(--z-base);
    padding-block: var(--space-12) var(--space-12);
  }

  @media (min-width: 48rem) {
    .hero__content {
      padding-block: var(--space-16) var(--space-16);
    }
  }

  .hero__inner {
    max-width: var(--container-narrow);
    display: grid;
    gap: var(--space-4);
  }

  .hero__eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }

  .hero__title {
    color: var(--color-media-text);
    text-wrap: balance;
  }

  .hero__lead {
    max-width: 38ch;
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-media-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
</style>
