---
interface ClientLogo {
  name: string;
  image: string;
  alt: string;
}

interface Props {
  logos: ClientLogo[];
}

const { logos } = Astro.props;
---

{logos.length > 0 && (
  <section class="client-logos section" aria-label="Firmy, se kterými jsem spolupracoval">
    <div class="container client-logos__inner">
      <p class="eyebrow client-logos__heading">Vybrané spolupráce</p>
      <div class="client-logos__viewport">
        <div class="client-logos__track">
          {[0, 1].map((copy) => (
            <div class="client-logos__group" aria-hidden={copy === 1 ? 'true' : undefined}>
              {logos.map((logo) => (
                <div class="client-logos__item" title={logo.name}>
                  <img src={logo.image} alt={copy === 0 ? logo.alt : ''} loading="lazy" />
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .client-logos {
    overflow: hidden;
    padding-block: var(--space-10);
    background: var(--color-surface);
    border-block: var(--border-thin) solid var(--color-border);
  }

  .client-logos__inner {
    display: grid;
    gap: var(--space-6);
  }

  .client-logos__heading {
    margin: 0;
    text-align: center;
  }

  .client-logos__viewport {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .client-logos__track {
    display: flex;
    width: max-content;
    animation: client-logos-right 48s linear infinite;
  }

  .client-logos__viewport:hover .client-logos__track,
  .client-logos__viewport:focus-within .client-logos__track {
    animation-play-state: paused;
  }

  .client-logos__group {
    display: flex;
    flex: none;
    align-items: center;
    gap: clamp(var(--space-10), 8vw, var(--space-24));
    padding-inline: clamp(var(--space-6), 4vw, var(--space-12));
  }

  .client-logos__item {
    display: grid;
    width: clamp(6.5rem, 11vw, 10rem);
    height: 3.75rem;
    place-items: center;
  }

  .client-logos__item img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.72;
    transition: filter var(--transition-fast), opacity var(--transition-fast);
  }

  .client-logos__item:hover img {
    filter: grayscale(0);
    opacity: 1;
  }

  @keyframes client-logos-right {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .client-logos__track {
      animation: none;
    }

    .client-logos__group[aria-hidden='true'] {
      display: none;
    }

    .client-logos__group {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
