---
/**
 * Logolišta klientů podle sekce 6.8 zadání (pouze schválená loga).
 * Dokud Jakub nedodá finální SVG/PNG loga a souhlasy, zobrazuje zástupné sloty.
 */
export interface ClientLogoItem {
  name: string;
  isPlaceholder?: boolean;
}

interface Props {
  heading?: string;
  logos: ClientLogoItem[];
}

const { heading = 'Spolupracoval jsem mimo jiné s', logos } = Astro.props;
---

<div class="logo-strip" data-reveal>
  <p class="logo-strip__heading">{heading}</p>
  <ul class="logo-strip__list">
    {
      logos.map((logo) => (
        <li class:list={['logo-strip__item', { 'is-placeholder': logo.isPlaceholder }]}>
          <span>{logo.name}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .logo-strip {
    display: grid;
    gap: var(--space-4);
  }

  .logo-strip__heading {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .logo-strip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .logo-strip__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .logo-strip__item {
    min-height: var(--space-16);
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .logo-strip__item.is-placeholder {
    border-style: dashed;
    border-color: var(--color-placeholder-border);
    background-color: var(--color-placeholder-bg);
    color: var(--color-placeholder-text);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
  }
</style>
