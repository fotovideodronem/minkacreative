---
/**
 * Lightbox komponenta postavená nad nativním <dialog> (sekce 6.3 zadání):
 * - zvětšení fotky i videa
 * - šipky, klávesnice (Esc, ArrowLeft, ArrowRight)
 * - dotykový swipe na mobilu
 * - přednačtení sousedních snímků
 * - popisek a alt text
 */
---

<dialog class="lightbox" data-lightbox-dialog aria-label="Prohlížeč médií">
  <div class="lightbox__shell">
    <header class="lightbox__bar">
      <p class="lightbox__counter" data-lightbox-counter>1 / 1</p>
      <button
        type="button"
        class="lightbox__close"
        data-lightbox-close
        aria-label="Zavřít prohlížeč (Esc)"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M5 5L15 15M15 5L5 15"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </header>

    <div class="lightbox__stage" data-lightbox-stage>
      <button
        type="button"
        class="lightbox__nav lightbox__nav--prev"
        data-lightbox-prev
        aria-label="Předchozí snímek"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M15 6L9 12L15 18"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>

      <div class="lightbox__viewport" data-lightbox-viewport></div>

      <button
        type="button"
        class="lightbox__nav lightbox__nav--next"
        data-lightbox-next
        aria-label="Další snímek"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M9 6L15 12L9 18"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>

    <footer class="lightbox__footer">
      <p class="lightbox__caption" data-lightbox-caption></p>
      <p class="lightbox__alt" data-lightbox-alt></p>
    </footer>
  </div>
</dialog>

<script>
  import { parseVideoSource } from '../utils/videoEmbed';

  interface LightboxEntry {
    src: string;
    width: string;
    height: string;
    alt: string;
    caption: string;
    video: string;
  }

  function initLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
    if (!dialog || dialog.dataset.bound === 'true') return;
    dialog.dataset.bound = 'true';

    const viewport = dialog.querySelector<HTMLElement>('[data-lightbox-viewport]');
    const stage = dialog.querySelector<HTMLElement>('[data-lightbox-stage]');
    const counterEl = dialog.querySelector<HTMLElement>('[data-lightbox-counter]');
    const captionEl = dialog.querySelector<HTMLElement>('[data-lightbox-caption]');
    const altEl = dialog.querySelector<HTMLElement>('[data-lightbox-alt]');
    const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]');

    if (!viewport || !stage || !counterEl || !captionEl || !altEl || !prevBtn || !nextBtn || !closeBtn) {
      return;
    }

    let activeItems: LightboxEntry[] = [];
    let currentIndex = 0;
    let lastTrigger: HTMLElement | null = null;
    const preloaded = new Set<string>();

    const preloadAt = (index: number) => {
      if (activeItems.length === 0) return;
      const wrapped = (index + activeItems.length) % activeItems.length;
      const src = activeItems[wrapped]?.src;
      if (!src || preloaded.has(src)) return;
      preloaded.add(src);
      const img = new Image();
      img.src = src;
    };

    const renderSlide = (index: number) => {
      if (activeItems.length === 0) return;
      currentIndex = (index + activeItems.length) % activeItems.length;
      const item = activeItems[currentIndex];

      counterEl.textContent = `${currentIndex + 1} / ${activeItems.length}`;
      captionEl.textContent = item.caption || '';
      captionEl.hidden = !item.caption;
      altEl.textContent = item.alt;

      const hasMultiple = activeItems.length > 1;
      prevBtn.hidden = !hasMultiple;
      nextBtn.hidden = !hasMultiple;

      const parsedVideo = item.video ? parseVideoSource(item.video) : null;

      if (parsedVideo && parsedVideo.kind === 'embed') {
        const wrap = document.createElement('div');
        wrap.className = 'lightbox__video-wrap';
        const iframe = document.createElement('iframe');
        iframe.src = parsedVideo.src;
        iframe.title = item.caption || item.alt;
        iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
        iframe.allowFullscreen = true;
        wrap.appendChild(iframe);
        viewport.replaceChildren(wrap);
      } else if (parsedVideo && parsedVideo.kind === 'file') {
        const video = document.createElement('video');
        video.className = 'lightbox__video';
        video.src = parsedVideo.src;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        viewport.replaceChildren(video);
      } else {
        const img = document.createElement('img');
        img.className = 'lightbox__img';
        img.src = item.src;
        img.alt = item.alt;
        if (item.width) img.width = Number(item.width);
        if (item.height) img.height = Number(item.height);
        viewport.replaceChildren(img);
      }

      if (hasMultiple) {
        preloadAt(currentIndex + 1);
        preloadAt(currentIndex - 1);
      }
    };

    const closeLightbox = () => {
      viewport.replaceChildren();
      if (dialog.open) dialog.close();
      lastTrigger?.focus();
    };

    prevBtn.addEventListener('click', () => renderSlide(currentIndex - 1));
    nextBtn.addEventListener('click', () => renderSlide(currentIndex + 1));
    closeBtn.addEventListener('click', closeLightbox);

    dialog.addEventListener('close', () => {
      viewport.replaceChildren();
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || event.target === stage || event.target === viewport) {
        closeLightbox();
      }
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        renderSlide(currentIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        renderSlide(currentIndex + 1);
      }
    });

    // Dotykový swipe na mobilu
    let touchStartX = 0;
    let touchStartY = 0;

    stage.addEventListener(
      'touchstart',
      (event) => {
        if (event.changedTouches.length !== 1) return;
        touchStartX = event.changedTouches[0].clientX;
        touchStartY = event.changedTouches[0].clientY;
      },
      { passive: true }
    );

    stage.addEventListener(
      'touchend',
      (event) => {
        if (event.changedTouches.length !== 1 || activeItems.length <= 1) return;
        const dx = event.changedTouches[0].clientX - touchStartX;
        const dy = event.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) {
          renderSlide(dx < 0 ? currentIndex + 1 : currentIndex - 1);
        }
      },
      { passive: true }
    );

    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement | null)?.closest<HTMLElement>(
        '[data-lightbox-item]'
      );
      if (!trigger) return;

      const group = trigger.dataset.lightboxGroup || '';
      const selector = group
        ? `[data-lightbox-item][data-lightbox-group="${CSS.escape(group)}"]`
        : '[data-lightbox-item]';
      const groupNodes = Array.from(document.querySelectorAll<HTMLElement>(selector));

      activeItems = groupNodes.map((node) => ({
        src: node.dataset.lightboxSrc || '',
        width: node.dataset.lightboxWidth || '',
        height: node.dataset.lightboxHeight || '',
        alt: node.dataset.lightboxAlt || '',
        caption: node.dataset.lightboxCaption || '',
        video: node.dataset.lightboxVideo || '',
      }));

      const clickedIndex = Math.max(0, groupNodes.indexOf(trigger));
      lastTrigger = trigger;
      renderSlide(clickedIndex);
      if (!dialog.open) dialog.showModal();
    });
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background-color: var(--color-overlay-backdrop);
    color: var(--color-media-text);
  }

  .lightbox::backdrop {
    background-color: var(--color-overlay-backdrop);
  }

  .lightbox__shell {
    height: 100%;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    padding: var(--space-3) var(--gutter) var(--space-4);
    gap: var(--space-3);
  }

  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .lightbox__counter {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-media-text-muted);
  }

  .lightbox__close,
  .lightbox__nav {
    width: var(--touch-target-min);
    height: var(--touch-target-min);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    border: var(--border-thin) solid var(--color-media-border);
    background-color: var(--color-media-surface);
    color: var(--color-media-text);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .lightbox__close:hover,
  .lightbox__nav:hover {
    border-color: var(--color-accent);
    background-color: var(--color-scrim-strong);
  }

  .lightbox__stage {
    position: relative;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }

  .lightbox__viewport {
    flex: 1;
    min-width: 0;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox :global(.lightbox__img),
  .lightbox :global(.lightbox__video) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
  }

  .lightbox :global(.lightbox__video-wrap) {
    width: min(100%, 64rem);
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .lightbox :global(.lightbox__video-wrap iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .lightbox__nav {
    flex-shrink: 0;
  }

  .lightbox__nav[hidden] {
    display: none;
  }

  @media (max-width: 47.99rem) {
    .lightbox__nav {
      position: absolute;
      bottom: var(--space-2);
      z-index: 2;
    }

    .lightbox__nav--prev {
      left: 0;
    }

    .lightbox__nav--next {
      right: 0;
    }
  }

  .lightbox__footer {
    text-align: center;
    display: grid;
    gap: var(--space-1);
    max-width: var(--container-narrow);
    margin-inline: auto;
  }

  .lightbox__caption {
    font-size: var(--text-sm);
    color: var(--color-media-text);
  }

  .lightbox__caption[hidden] {
    display: none;
  }

  .lightbox__alt {
    font-size: var(--text-xs);
    color: var(--color-media-text-muted);
  }
</style>
