---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const gradientId = `brand-logo-peach-${className.replace(/[^a-zA-Z0-9_-]/g, '-') || 'default'}`;
---

<svg
  class:list={['brand-logo', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 400 128"
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="0.8" y2="1">
      <stop offset="0" stop-color="#f6a58f" />
      <stop offset="1" stop-color="#ffe3c3" />
    </linearGradient>
  </defs>
  <circle class="brand-logo__badge" cx="64" cy="64" r="55" fill={`url(#${gradientId})`} />
  <path
    class="brand-logo__monogram"
    d="M37 85 48 28c1-5 8-5 8 1l-5 32 13-31c3-7 11-6 10 2l-4 30 14-30c3-6 12-4 10 3L87 85"
  />
  <text class="brand-logo__wordmark" x="133" y="77">MINKA</text>
  <text class="brand-logo__tagline" x="236" y="108" text-anchor="middle">CREATIVE</text>
</svg>

<style>
  .brand-logo {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    color: var(--color-text);
  }

  .brand-logo__monogram {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .brand-logo__wordmark {
    fill: currentColor;
    font-family: 'Space Grotesk', Arial, sans-serif;
    font-size: 58px;
    font-weight: 700;
    letter-spacing: 0.6px;
  }

  .brand-logo__tagline {
    fill: #e99883;
    font-family: 'Inter', Arial, sans-serif;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 2px;
  }
</style>
