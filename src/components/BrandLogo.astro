---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
const mClipId = `brand-logo-m-${className.replace(/[^a-zA-Z0-9_-]/g, '-') || 'default'}`;
---

<svg
  class:list={['brand-logo', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 320 108"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id={mClipId}>
      <text class="brand-logo__m-mask" x="5" y="72">M</text>
    </clipPath>
  </defs>
  <text class="brand-logo__wordmark" x="5" y="72">MINKA</text>
  <rect
    class="brand-logo__m-accent"
    x="5"
    y="0"
    width="25"
    height="80"
    clip-path={`url(#${mClipId})`}
  />
  <text class="brand-logo__tagline" x="123.5" y="101" text-anchor="middle">CREATIVE</text>
</svg>

<style>
  .brand-logo {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    color: var(--color-text);
  }

  .brand-logo__wordmark {
    fill: currentColor;
    font-family: 'Space Grotesk', Arial, sans-serif;
    font-size: 76px;
    font-weight: 700;
    letter-spacing: 0.6px;
  }

  .brand-logo__m-mask {
    font-family: 'Space Grotesk', Arial, sans-serif;
    font-size: 76px;
    font-weight: 700;
    letter-spacing: 0.6px;
  }

  .brand-logo__m-accent {
    fill: var(--color-accent);
  }

  .brand-logo__tagline {
    fill: currentColor;
    font-family: 'Inter', Arial, sans-serif;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.6px;
  }
</style>
