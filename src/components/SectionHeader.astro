---
import Button from './Button.astro';
import { getPageCopy } from '../utils/pageCopy';

/**
 * Záhlaví obsahové sekce s nadpisem, volitelným štítkem, perexem a odkazem.
 */
interface Props {
  eyebrow?: string;
  heading: string;
  lead?: string;
  align?: 'left' | 'center';
  actionLabel?: string;
  actionHref?: string;
  headingLevel?: 'h1' | 'h2';
  cmsEditable?: boolean;
}

const {
  eyebrow,
  heading,
  lead,
  align = 'left',
  actionLabel,
  actionHref,
  headingLevel = 'h2',
  cmsEditable = false,
} = Astro.props;

const pageKey = Astro.url.pathname === '/'
  ? 'home'
  : Astro.url.pathname.split('/').filter(Boolean).join('-');
const pageCopy = cmsEditable ? await getPageCopy(pageKey) : undefined;
const HeadingTag = headingLevel;
---

<div class:list={['section-header', `section-header--${align}`]} data-reveal>
  <div class="section-header__copy">
    {(pageCopy?.data.eyebrow || eyebrow) && (
      <span class="eyebrow">{pageCopy?.data.eyebrow || eyebrow}</span>
    )}
    <HeadingTag class="section-header__title">{pageCopy?.data.heading || heading}</HeadingTag>
    {(pageCopy?.data.lead || lead) && (
      <p class="lead section-header__lead">{pageCopy?.data.lead || lead}</p>
    )}
  </div>

  {
    actionLabel && actionHref && (
      <div class="section-header__action">
        <Button href={actionHref} variant="secondary">
          {actionLabel}
        </Button>
      </div>
    )
  }
</div>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 48rem) {
    .section-header--left {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .section-header {
      margin-bottom: var(--space-10);
    }
  }

  .section-header--center {
    text-align: center;
    align-items: center;
  }

  .section-header__copy {
    display: grid;
    gap: var(--space-3);
    max-width: var(--container-narrow);
  }

  .section-header--center .section-header__copy {
    justify-items: center;
  }

  .section-header__title {
    font-size: var(--text-3xl);
    max-width: 19ch;
    text-wrap: balance;
  }

  .section-header .eyebrow::before {
    content: '{ ';
  }

  .section-header .eyebrow::after {
    content: ' }';
  }

  .section-header__action {
    flex-shrink: 0;
  }
</style>
