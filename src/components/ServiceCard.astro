---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Karta služby podle sekce 6.5 zadání:
 * velký obrázek přes astro:assets, nadpis a jedna věta.
 */
interface Props {
  title: string;
  summary: string;
  href: string;
  image: ImageMetadata;
  imageAlt: string;
  eyebrow?: string;
  priceNote?: string;
  ctaLabel?: string;
}

const {
  title,
  summary,
  href,
  image,
  imageAlt,
  eyebrow,
  priceNote,
  ctaLabel = 'Více o službě',
} = Astro.props;
---

<article class="service-card" data-reveal>
  <a class="service-card__link" href={href}>
    <div class="service-card__media">
      <Picture
        src={image}
        alt={imageAlt}
        formats={['avif', 'webp']}
        widths={[480, 768, 1080]}
        sizes="(min-width: 64rem) 31vw, (min-width: 48rem) 46vw, 94vw"
        loading="lazy"
        decoding="async"
        class="service-card__img"
      />
    </div>

    <div class="service-card__body">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h3 class="service-card__title">{title}</h3>
      <p class="service-card__summary">{summary}</p>
      <div class="service-card__footer">
        {priceNote && <span class="service-card__price">{priceNote}</span>}
        <span class="service-card__cta">
          {ctaLabel} <span aria-hidden="true">&rarr;</span>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .service-card {
    background-color: var(--color-surface);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color var(--transition-base),
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  .service-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(calc(-1 * var(--space-1)));
    box-shadow: var(--shadow-sm);
  }

  .service-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  .service-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-surface-elevated);
  }

  .service-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .service-card:hover .service-card__img {
    transform: scale(1.03);
  }

  .service-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
  }

  .service-card__title {
    font-size: var(--text-xl);
    color: var(--color-text);
  }

  .service-card__summary {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .service-card__footer {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: var(--border-thin) solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .service-card__price {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .service-card__cta {
    margin-left: auto;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-accent-ink);
  }
</style>
