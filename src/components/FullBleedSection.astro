---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';

/**
 * Sekce přes celou šířku obrazovky s fotografií a krátkým textem (sekce 6.4 zadání).
 * Scrim zajišťuje čitelný kontrast v obou barevných variantách webu.
 */
interface Props {
  eyebrow?: string;
  heading: string;
  summary: string;
  image: ImageMetadata;
  imageAlt: string;
  ctaLabel?: string;
  ctaHref?: string;
  align?: 'left' | 'center';
  height?: 'md' | 'lg';
}

const {
  eyebrow,
  heading,
  summary,
  image,
  imageAlt,
  ctaLabel,
  ctaHref,
  align = 'left',
  height = 'md',
} = Astro.props;
---

<section class:list={['full-bleed', `full-bleed--${height}`, `full-bleed--${align}`]} data-reveal>
  <div class="full-bleed__media" aria-hidden="true">
    <Picture
      src={image}
      alt={imageAlt}
      formats={['avif', 'webp']}
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      class="full-bleed__img"
    />
    <div class="full-bleed__scrim"></div>
  </div>

  <div class="container full-bleed__content">
    <div class="full-bleed__inner">
      {eyebrow && <span class="full-bleed__eyebrow">{eyebrow}</span>}
      <h2 class="full-bleed__title">{heading}</h2>
      <p class="full-bleed__summary">{summary}</p>
      {
        ctaLabel && ctaHref && (
          <div class="full-bleed__actions">
            <Button href={ctaHref} variant="media-secondary" size="lg">
              {ctaLabel}
            </Button>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .full-bleed {
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  .full-bleed--md {
    min-height: clamp(22rem, 56svh, 36rem);
  }

  .full-bleed--lg {
    min-height: clamp(28rem, 72svh, 46rem);
  }

  .full-bleed--center {
    align-items: center;
    text-align: center;
  }

  .full-bleed__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .full-bleed__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .full-bleed__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--color-scrim-strong) 0%,
      var(--color-scrim-mid) 55%,
      var(--color-scrim-soft) 100%
    );
  }

  .full-bleed--center .full-bleed__scrim {
    background: radial-gradient(
      circle at center,
      var(--color-scrim-strong) 0%,
      var(--color-scrim-mid) 100%
    );
  }

  .full-bleed__content {
    position: relative;
    z-index: var(--z-base);
    padding-block: var(--space-12);
  }

  @media (min-width: 48rem) {
    .full-bleed__content {
      padding-block: var(--space-16);
    }
  }

  .full-bleed__inner {
    max-width: var(--container-narrow);
    display: grid;
    gap: var(--space-3);
  }

  .full-bleed--center .full-bleed__inner {
    margin-inline: auto;
    justify-items: center;
  }

  .full-bleed__eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent-ink);
  }

  .full-bleed__title {
    font-size: var(--text-3xl);
    color: var(--color-media-text);
    text-wrap: balance;
  }

  .full-bleed__summary {
    max-width: 42ch;
    font-size: var(--text-lg);
    color: var(--color-media-text-muted);
  }

  .full-bleed__actions {
    margin-top: var(--space-3);
  }
</style>
