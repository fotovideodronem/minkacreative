---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Masonry galerie podle sekce 6.2 zadání:
 * - zachovává původní poměr stran fotek bez posunu layoutu (CLS = 0)
 * - využívá astro:assets (AVIF + WebP, lazy loading)
 * - na mobilu 1 sloupec v přirozeném pořadí, na větších obrazovkách CSS sloupce
 * - každý snímek otevírá Lightbox
 */
export interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  videoUrl?: string;
}

interface Props {
  items: GalleryItem[];
  galleryId?: string;
  columns?: 2 | 3;
}

const { items, galleryId = 'galerie', columns = 3 } = Astro.props;

const resolvedItems = await Promise.all(
  items.map(async (item) => {
    const lightboxTargetWidth = Math.min(item.image.width, 1600);
    const fullImage = await getImage({
      src: item.image,
      width: lightboxTargetWidth,
      format: 'webp',
    });

    return {
      ...item,
      lightboxSrc: fullImage.src,
      lightboxWidth: fullImage.attributes.width ?? item.image.width,
      lightboxHeight: fullImage.attributes.height ?? item.image.height,
    };
  })
);
---

<div
  class:list={['masonry-gallery', `masonry-gallery--cols-${columns}`]}
  aria-label="Fotogalerie"
>
  {
    resolvedItems.map((item, index) => (
      <figure class="masonry-item" data-reveal>
        <button
          type="button"
          class="masonry-item__trigger"
          data-lightbox-item
          data-lightbox-group={galleryId}
          data-lightbox-index={index}
          data-lightbox-src={item.lightboxSrc}
          data-lightbox-width={item.lightboxWidth}
          data-lightbox-height={item.lightboxHeight}
          data-lightbox-alt={item.alt}
          data-lightbox-caption={item.caption ?? ''}
          data-lightbox-video={item.videoUrl ?? ''}
          aria-label={`Zvětšit: ${item.alt}`}
        >
          <Picture
            src={item.image}
            alt={item.alt}
            formats={['avif', 'webp']}
            widths={[420, 720, 1080]}
            sizes={
              columns === 2
                ? '(min-width: 48rem) 46vw, 94vw'
                : '(min-width: 64rem) 31vw, (min-width: 48rem) 46vw, 94vw'
            }
            loading="lazy"
            decoding="async"
            class="masonry-item__img"
          />

          {item.videoUrl && (
            <span class="masonry-item__video-badge" aria-hidden="true">
              Video
            </span>
          )}
        </button>

        {item.caption && (
          <figcaption class="caption masonry-item__caption">{item.caption}</figcaption>
        )}
      </figure>
    ))
  }
</div>

<style>
  .masonry-gallery {
    column-count: 1;
    column-gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .masonry-gallery {
      column-count: 2;
    }
  }

  @media (min-width: 64rem) {
    .masonry-gallery--cols-3 {
      column-count: 3;
    }
  }

  .masonry-item {
    margin: 0 0 var(--space-5);
    break-inside: avoid;
    display: grid;
    gap: var(--space-2);
  }

  .masonry-item__trigger {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface);
    cursor: zoom-in;
    transition:
      border-color var(--transition-fast),
      transform var(--transition-base);
  }

  .masonry-item__trigger:hover {
    border-color: var(--color-accent);
  }

  .masonry-item__img {
    width: 100%;
    height: auto;
    transition: transform var(--transition-slow);
  }

  .masonry-item__trigger:hover .masonry-item__img {
    transform: scale(1.02);
  }

  .masonry-item__video-badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-media-text);
    background-color: var(--color-media-surface);
    border: var(--border-thin) solid var(--color-media-border);
    border-radius: var(--radius-pill);
  }

  .masonry-item__caption {
    padding-inline: var(--space-1);
  }
</style>
