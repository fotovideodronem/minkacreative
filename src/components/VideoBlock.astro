---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { parseVideoSource } from '../utils/videoEmbed';
import placeholderLandscape from '../assets/placeholders/landscape-4x3.png';

/**
 * Video blok s náhledovým obrázkem a načtením externího přehrávače až po kliknutí
 * (sekce 3 a 6.6 zadání — YouTube, Vimeo, Bunny Stream nebo přímé video).
 */
interface Props {
  title: string;
  /** src prop alias — interně mapujeme na videoUrl */
  src?: string;
  poster?: ImageMetadata;
  posterAlt?: string;
  videoUrl?: string;
  duration?: string;
  caption?: string;
}

const { title, poster, posterAlt = '', src, videoUrl: videoUrlProp, duration, caption } = Astro.props;
const resolvedUrl = src ?? videoUrlProp;
const parsed = parseVideoSource(resolvedUrl);
const resolvedPoster: ImageMetadata = poster ?? placeholderLandscape;
---

<figure class="video-block" data-reveal>
  <div
    class="video-block__frame"
    data-video-block
    data-video-kind={parsed.kind}
    data-video-src={parsed.src}
    data-video-title={title}
  >
    <Picture
      src={resolvedPoster}
      alt={posterAlt}
      formats={['avif', 'webp']}
      widths={[640, 1024, 1440]}
      sizes="(min-width: 64rem) 78vw, 94vw"
      loading="lazy"
      decoding="async"
      class="video-block__poster"
    />

    <div class="video-block__scrim" aria-hidden="true"></div>

    <button
      type="button"
      class="video-block__play"
      data-video-play
      aria-label={`Přehrát video: ${title}`}
    >
      <span class="video-block__play-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5.5v13l11-6.5-11-6.5z"></path>
        </svg>
      </span>
      <span class="video-block__play-meta">
        <span class="video-block__play-title">{title}</span>
        <span class="video-block__play-sub">
          {
            parsed.kind === 'placeholder'
              ? '[DOPLNIT: odkaz na externí video]'
              : duration
                ? `Přehrát video · ${duration}`
                : 'Přehrát video'
          }
        </span>
      </span>
    </button>

    <div class="video-block__placeholder-msg" data-video-placeholder hidden role="status">
      <p>
        Zatím není připojené externí video: <strong>{parsed.src}</strong>
      </p>
      <button type="button" class="video-block__reset" data-video-reset>
        Zpět na náhled
      </button>
    </div>
  </div>

  {caption && <figcaption class="caption video-block__caption">{caption}</figcaption>}
</figure>

<script>
  function initVideoBlocks() {
    document.querySelectorAll<HTMLElement>('[data-video-block]').forEach((block) => {
      if (block.dataset.bound === 'true') return;
      block.dataset.bound = 'true';

      const playBtn = block.querySelector<HTMLButtonElement>('[data-video-play]');
      const placeholderBox = block.querySelector<HTMLElement>('[data-video-placeholder]');
      const resetBtn = block.querySelector<HTMLButtonElement>('[data-video-reset]');

      if (!playBtn) return;

      playBtn.addEventListener('click', () => {
        const kind = block.dataset.videoKind;
        const src = block.dataset.videoSrc;
        const title = block.dataset.videoTitle || 'Video';

        if (!src || kind === 'placeholder') {
          if (placeholderBox) {
            playBtn.hidden = true;
            placeholderBox.hidden = false;
          }
          return;
        }

        if (kind === 'file') {
          const video = document.createElement('video');
          video.className = 'video-block__player';
          video.src = src;
          video.controls = true;
          video.autoplay = true;
          video.playsInline = true;
          video.setAttribute('aria-label', title);
          block.replaceChildren(video);
          video.focus();
          return;
        }

        const iframe = document.createElement('iframe');
        iframe.className = 'video-block__player';
        iframe.src = src;
        iframe.title = title;
        iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        block.replaceChildren(iframe);
      });

      if (resetBtn && placeholderBox) {
        resetBtn.addEventListener('click', () => {
          placeholderBox.hidden = true;
          playBtn.hidden = false;
          playBtn.focus();
        });
      }
    });
  }

  initVideoBlocks();
  document.addEventListener('astro:page-load', initVideoBlocks);
</script>

<style>
  .video-block {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .video-block__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    border: var(--border-thin) solid var(--color-border);
  }

  .video-block__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-block__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--color-scrim-strong) 0%,
      var(--color-scrim-soft) 65%
    );
    pointer-events: none;
  }

  .video-block__play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: var(--space-6);
    border: none;
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    text-align: center;
    cursor: pointer;
    color: var(--color-media-text);
  }

  .video-block__play[hidden] {
    display: none;
  }

  .video-block__play-icon {
    width: var(--space-16);
    height: var(--space-16);
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-accent);
    color: var(--color-accent-text);
    box-shadow: var(--shadow-lg);
    transition:
      transform var(--transition-fast),
      background-color var(--transition-fast);
  }

  .video-block__play:hover .video-block__play-icon {
    transform: scale(1.07);
    background-color: var(--color-accent-hover);
  }

  .video-block__play-meta {
    display: grid;
    gap: var(--space-1);
  }

  .video-block__play-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-media-text);
  }

  .video-block__play-sub {
    font-size: var(--text-sm);
    color: var(--color-media-text-muted);
  }

  .video-block__placeholder-msg {
    position: absolute;
    inset: 0;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    text-align: center;
    background-color: var(--color-overlay-backdrop);
    color: var(--color-media-text);
  }

  .video-block__placeholder-msg[hidden] {
    display: none;
  }

  .video-block__reset {
    min-height: var(--touch-target-min);
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-media-surface);
    color: var(--color-media-text);
    border: var(--border-thin) solid var(--color-media-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .video-block :global(.video-block__player) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
