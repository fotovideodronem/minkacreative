---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Děkuji za poptávku | Minka Creative"
  description="Poptávka byla úspěšně odeslána. Odpovím do 24 hodin."
  noindex={true}
>
  <section class="section thankyou-section">
    <div class="container thankyou-container">

      <div class="thankyou-icon" aria-hidden="true">
        <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="32" cy="32" r="32" fill="var(--color-accent-soft)" />
          <path
            d="M20 32l9 9 15-15"
            stroke="var(--color-accent-ink)"
            stroke-width="3.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>

      <h1 class="thankyou-heading">Děkuji za poptávku!</h1>

      <p class="thankyou-lead">
        Zpráva dorazila. Odpovím do <strong>24 hodin</strong> — a domluvíme se na dalším kroku.
      </p>

      <p class="thankyou-sub">
        Pokud potřebujete něco řešit okamžitě, zavolejte přímo:
      </p>

      <a href={siteConfig.contact.phoneHref} class="thankyou-phone">
        {siteConfig.contact.phoneDisplay}
      </a>

      <div class="thankyou-actions">
        <Button href="/" variant="primary">Zpět na úvodní stránku</Button>
        <Button href="/portfolio/" variant="ghost">Prohlédnout portfolio</Button>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .thankyou-section {
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .thankyou-container {
    max-width: 540px;
    text-align: center;
  }

  .thankyou-icon {
    margin-bottom: var(--space-6);
  }

  .thankyou-heading {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 700;
    color: var(--color-heading);
    margin-bottom: var(--space-4);
  }

  .thankyou-lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
    max-width: 40ch;
    margin-inline: auto;
  }

  .thankyou-sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .thankyou-phone {
    display: inline-block;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-accent-ink);
    text-decoration: none;
    margin-bottom: var(--space-10);
    transition: color 0.15s;
  }

  .thankyou-phone:hover {
    color: var(--color-accent-hover);
  }

  .thankyou-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
</style>
