---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HeroSection from '../components/HeroSection.astro';
import FullBleedSection from '../components/FullBleedSection.astro';
import MasonryGallery from '../components/MasonryGallery.astro';
import Lightbox from '../components/Lightbox.astro';
import VideoBlock from '../components/VideoBlock.astro';

import heroPoster from '../assets/placeholders/hero-16x9.png';
import fullBleedImg from '../assets/placeholders/fullbleed-21x9.png';
import landscapeImg from '../assets/placeholders/landscape-4x3.png';
import portraitImg from '../assets/placeholders/portrait-3x4.png';
import tallImg from '../assets/placeholders/tall-4x5.png';
import squareImg from '../assets/placeholders/square-1x1.png';

const galleryItems = [
  {
    image: portraitImg,
    alt: '[DOPLNIT: popis zástupného snímku na výšku 3:4]',
    caption: '[DOPLNIT: Popisek snímku 1 · poměr stran 3:4]',
  },
  {
    image: landscapeImg,
    alt: '[DOPLNIT: popis zástupného snímku na šířku 4:3]',
    caption: '[DOPLNIT: Popisek snímku 2 · poměr stran 4:3]',
  },
  {
    image: tallImg,
    alt: '[DOPLNIT: popis zástupného snímku 4:5]',
    caption: '[DOPLNIT: Popisek snímku 3 · poměr stran 4:5]',
  },
  {
    image: squareImg,
    alt: '[DOPLNIT: popis zástupného čtvercového snímku 1:1]',
    caption: '[DOPLNIT: Popisek snímku 4 · poměr stran 1:1]',
  },
  {
    image: heroPoster,
    alt: '[DOPLNIT: popis širokoúhlého snímku 16:9]',
    caption: '[DOPLNIT: Popisek snímku 5 · poměr stran 16:9]',
  },
  {
    image: fullBleedImg,
    alt: '[DOPLNIT: popis panoramatického snímku 21:9]',
    caption: '[DOPLNIT: Popisek snímku 6 · poměr stran 21:9]',
  },
];
---

<BaseLayout
  title="Design systém (Fáze 2) | Minka Creative"
  description="Náhled komponent design systému Minka Creative — typografie, tlačítka, karty, hero, celošířková sekce, masonry galerie, lightbox a video blok."
  noindex={true}
>
  <!-- Přepínač náhledu barevných variant (Tmavá A / Světlá B) -->
  <div class="ds-toolbar" role="region" aria-label="Přepínač náhledu tématu">
    <div class="container ds-toolbar__inner">
      <p class="ds-toolbar__label">
        <strong>Design systém · Fáze 2</strong>
        <span>(interní náhled všech komponent a obou barevných variant)</span>
      </p>
      <div class="ds-toolbar__actions" role="group" aria-label="Barevná varianta">
        <button type="button" class="ds-theme-btn is-active" data-set-theme="dark">
          Varianta A: Tmavá
        </button>
        <button type="button" class="ds-theme-btn" data-set-theme="light">
          Varianta B: Světlá
        </button>
      </div>
    </div>
  </div>

  <!-- 1. Hero sekce -->
  <HeroSection
    eyebrow="[DOPLNIT: Krátký štítek — např. Foto · Video · Dron]"
    heading="[DOPLNIT: Krátký hlavní nadpis titulní stránky]"
    lead="[DOPLNIT: Jedna stručná věta o tom, co děláš a pro koho.]"
    poster={heroPoster}
    posterAlt="[DOPLNIT: Zástupný náhledový snímek pro Hero sekci]"
    primaryCta={{ label: 'Nezávazná poptávka', href: '/kontakt/' }}
    secondaryCta={{ label: 'Portfolio', href: '/portfolio/' }}
  />

  <!-- 2. Typografie a barevné tokeny -->
  <section class="section">
    <div class="container ds-stack">
      <SectionHeader
        eyebrow="01 · Typografie a základy"
        heading="Hierarchie písem a textových stylů"
        lead="Písma Plus Jakarta Sans a Inter hostovaná lokálně bez externích požadavků."
      />

      <div class="grid grid--2">
        <div class="ds-panel">
          <span class="eyebrow">Nadpisy a text</span>
          <p class="ds-type-sample--h1">Nadpis H1</p>
          <h2>Nadpis H2 — sekce</h2>
          <h3>Nadpis H3 — podsekce nebo karta</h3>
          <p class="lead">
            Perex (.lead): stručný úvodní odstavec pro souhrn stránky (50 až 80 slov podle zadání).
          </p>
          <div class="prose">
            <p>
              Běžný odstavec (.prose): krátké věty, maximálně dvě až tři v odstavci.
              <strong>Důležitý údaj</strong> vynikne bez vizuálního šumu.
            </p>
            <ul>
              <li>[DOPLNIT: Konkrétní údaj č. 1 — např. termín dodání]</li>
              <li>[DOPLNIT: Konkrétní údaj č. 2 — např. rozsah a formáty]</li>
              <li>[DOPLNIT: Konkrétní údaj č. 3 — např. oblast působení]</li>
            </ul>
          </div>
        </div>

        <div class="ds-panel">
          <span class="eyebrow">Citát a paleta tokenů</span>
          <figure class="quote-block">
            <blockquote>
              „[DOPLNIT: Skutečná citace klienta — nevymýšlet předem.]“
            </blockquote>
            <figcaption>[DOPLNIT: Jméno klienta · Firma]</figcaption>
          </figure>

          <div class="ds-swatches" aria-label="Ukázka barevných tokenů">
            <div class="ds-swatch">
              <span class="ds-swatch__chip" style="background: var(--color-bg)"></span>
              <span>Pozadí</span>
            </div>
            <div class="ds-swatch">
              <span class="ds-swatch__chip" style="background: var(--color-surface)"></span>
              <span>Povrch</span>
            </div>
            <div class="ds-swatch">
              <span class="ds-swatch__chip" style="background: var(--color-accent)"></span>
              <span>Akcent</span>
            </div>
            <div class="ds-swatch">
              <span class="ds-swatch__chip" style="background: var(--color-text)"></span>
              <span>Text</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Tlačítka -->
  <section class="section section--surface">
    <div class="container ds-stack">
      <SectionHeader
        eyebrow="02 · Tlačítka"
        heading="Interaktivní stavy a velikosti"
        lead="Minimální dotyková výška 44 px, jasný hover i klávesnicový focus."
      />

      <div class="ds-button-row">
        <Button href="/kontakt/" variant="primary" size="lg">Primární velké</Button>
        <Button href="/portfolio/" variant="primary" size="md">Primární střední</Button>
        <Button href="/sluzby/" variant="secondary" size="md">Sekundární</Button>
        <Button href="/o-mne/" variant="ghost" size="md">Textové (ghost)</Button>
        <Button href="https://minka-weddings.cz" variant="secondary" external>
          Externí odkaz
        </Button>
      </div>
    </div>
  </section>

  <!-- 4. Karty služeb a projektů -->
  <section class="section">
    <div class="container ds-stack">
      <SectionHeader
        eyebrow="03 · Karty"
        heading="Karty služeb"
        lead="Velký obrázek přes astro:assets (AVIF/WebP), pevný poměr stran, nadpis a jedna věta."
        actionLabel="Přehled služeb"
        actionHref="/sluzby/"
      />

      <div class="grid grid--3">
        <ServiceCard
          eyebrow="Služba"
          title="[DOPLNIT: Název služby 1]"
          summary="[DOPLNIT: Jedna stručná věta popisující službu a přínos pro klienta.]"
          href="/stavebni-fotoreporty/"
          image={landscapeImg}
          imageAlt="[DOPLNIT: Zástupný náhled služby 1]"
          priceNote="[DOPLNIT: Od ... Kč]"
        />
        <ServiceCard
          eyebrow="Služba"
          title="[DOPLNIT: Název služby 2]"
          summary="[DOPLNIT: Jedna stručná věta popisující službu a přínos pro klienta.]"
          href="/pro-firmy/"
          image={heroPoster}
          imageAlt="[DOPLNIT: Zástupný náhled služby 2]"
          priceNote="[DOPLNIT: Od ... Kč]"
        />
        <ServiceCard
          eyebrow="Služba"
          title="[DOPLNIT: Název služby 3]"
          summary="[DOPLNIT: Jedna stručná věta popisující službu a přínos pro klienta.]"
          href="/sluzby/dron/"
          image={fullBleedImg}
          imageAlt="[DOPLNIT: Zástupný náhled služby 3]"
          priceNote="[DOPLNIT: Od ... Kč]"
        />
      </div>

      <div class="ds-spacer"></div>

      <SectionHeader
        eyebrow="04 · Karty projektů"
        heading="Ukázka datového modelu projektů"
        lead="Vztah ke klientovi určuje, zda se název klienta zobrazí veřejně."
        actionLabel="Celé portfolio"
        actionHref="/portfolio/"
      />

      <div class="grid grid--2">
        <ProjectCard
          title="[DOPLNIT: Ukázkový projekt — přímý klient]"
          href="/portfolio/ukazka-stavba/"
          summary="[DOPLNIT: Krátké shrnutí projektu na 1 až 2 věty.]"
          image={landscapeImg}
          imageAlt="[DOPLNIT: Zástupný snímek projektu 1]"
          year="2026"
          location="Vlašim"
          services={['Foto', 'Dron']}
          client="[DOPLNIT: Název klienta]"
          showClientName={true}
          relationship="direct"
        />
        <ProjectCard
          title="[DOPLNIT: Ukázkový projekt — subdodávka bez klienta]"
          href="/portfolio/ukazka-firemni-video/"
          summary="[DOPLNIT: Krátké shrnutí projektu — u subdodávky se jméno klienta neuvádí.]"
          image={heroPoster}
          imageAlt="[DOPLNIT: Zástupný snímek projektu 2]"
          year="2026"
          location="Benešov"
          services={['Video']}
          client="Skrytý klient"
          showClientName={false}
          relationship="subcontract"
        />
      </div>
    </div>
  </section>

  <!-- 5. Sekce přes celou šířku -->
  <FullBleedSection
    eyebrow="05 · Celošířková sekce"
    heading="[DOPLNIT: Nadpis celošířkové sekce přes fotografii]"
    summary="[DOPLNIT: Krátké sdělení na 1 až 2 věty s garantovaným kontrastem nad snímkem.]"
    image={fullBleedImg}
    imageAlt="[DOPLNIT: Zástupný snímek celošířkové sekce]"
    ctaLabel="Nezávazná poptávka"
    ctaHref="/kontakt/"
    height="md"
  />

  <!-- 6. Masonry galerie + Lightbox -->
  <section class="section">
    <div class="container ds-stack">
      <SectionHeader
        eyebrow="06 · Masonry galerie a Lightbox"
        heading="Zachování poměru stran a zvětšení na kliknutí"
        lead="Kliknutím na snímek se otevře Lightbox s klávesnicí (Esc, šipky), dotykovým swipem na mobilu a přednačtením sousedního snímku."
      />

      <MasonryGallery items={galleryItems} galleryId="ds-ukazka" />
    </div>
  </section>

  <!-- 7. Video blok -->
  <section class="section section--surface">
    <div class="container container--narrow ds-stack">
      <SectionHeader
        eyebrow="07 · Video blok"
        heading="Externí video načítané až po kliknutí"
        lead="Do kliknutí na Play se načítá pouze lehký náhledový obrázek přes astro:assets."
      />

      <VideoBlock
        title="[DOPLNIT: Název ukázkového videa]"
        poster={heroPoster}
        posterAlt="[DOPLNIT: Zástupný náhled videa]"
        duration="01:45"
        caption="[DOPLNIT: Popisek pod video blokem — po doplnění YouTube / Vimeo / Bunny URL se po kliknutí načte přehrávač.]"
      />
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<script>
  function initThemePreviewSwitcher() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-theme]');
    if (buttons.length === 0) return;

    const applyTheme = (theme: string) => {
      document.documentElement.dataset.theme = theme;
      buttons.forEach((btn) => {
        btn.classList.toggle('is-active', btn.dataset.setTheme === theme);
      });
    };

    const current = document.documentElement.dataset.theme || 'dark';
    applyTheme(current);

    buttons.forEach((btn) => {
      if (btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const theme = btn.dataset.setTheme;
        if (theme) applyTheme(theme);
      });
    });
  }

  initThemePreviewSwitcher();
  document.addEventListener('astro:page-load', initThemePreviewSwitcher);
</script>

<style>
  .ds-type-sample--h1 {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .ds-toolbar {
    background-color: var(--color-surface);
    border-bottom: var(--border-thin) solid var(--color-border);
    padding-block: var(--space-3);
  }

  .ds-toolbar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .ds-toolbar__label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .ds-toolbar__label strong {
    color: var(--color-text);
  }

  .ds-toolbar__actions {
    display: inline-flex;
    gap: var(--space-2);
  }

  .ds-theme-btn {
    min-height: var(--touch-target-min);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-text-muted);
    background-color: var(--color-bg);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .ds-theme-btn.is-active {
    color: var(--color-accent-text);
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .ds-stack {
    display: grid;
    gap: var(--space-6);
  }

  .ds-spacer {
    height: var(--space-6);
  }

  .ds-panel {
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-lg);
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .ds-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .ds-swatch {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .ds-swatch__chip {
    height: var(--space-10);
    border-radius: var(--radius-md);
    border: var(--border-thin) solid var(--color-border-strong);
  }

  .ds-button-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
</style>
